{
  "name": "dubparty",
  "private": true,
  "version": "2.0.0",
  "description": "DubParty — online dubbing game with friends",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build -c vite.ai.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "models": "node scripts/fetch-models.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@supabase/supabase-js": "^2.119.0",
    "jszip": "^3.10.2",
    "peerjs": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
